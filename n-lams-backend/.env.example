# N-LAMS Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL with PostGIS on port 3000, fallback to SQLite if postgres is offline)
DATABASE_URL=postgresql://postgres:password@127.0.0.1:3000/nlams
SQLITE_FALLBACK_URL=sqlite:///./nlams.db

# JWT Authentication
JWT_SECRET=nlams-national-infrastructure-jwt-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3008,http://localhost:3009,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3008,http://127.0.0.1:3009,http://127.0.0.1:5173

# Storage Paths
UPLOAD_DIR=uploads
MODEL_DIR=app/ml/model
